# Local SQLite database (relative to the project root). Do not move it into .next or tmp folders.
DATABASE_URL="file:./data/taskpilot.db"

# Optional (Phase 5). The app works without it. Keep it server-side only.
GEMINI_API_KEY=""

# Where evidence screenshots and attachments are stored (relative to the project root). Never inside .next or tmp folders.
UPLOADS_DIR="./uploads"

# Application timezone (fixed-offset zones only): Asia/Jakarta, Asia/Makassar, Asia/Jayapura, Asia/Bangkok, Asia/Singapore, UTC.
# Restart the server after changing it.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

# Where backups are saved (relative to the project root).
BACKUPS_DIR="./backups"
